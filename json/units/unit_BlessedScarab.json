{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnBlessedScarab",
            "names": {
                "english": "Blessed Scarab",
                "chinese": "镀金圣甲虫"
            },
            "card_art": "@BlessedScarab",
            "cost": 1,
            "card_type": "monster",
            "rarity": "uncommon",
            "class": "@ClassSandscourged",
            "targets_room": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@SpawnBlessedScarab"
            ],
            "lore_tooltips": [
                {
                    "english": "The Ur-Pharaoh revels in greed and opulence. Some of his spawn are adorned in precious metals and gems, taken from what little the Scourged have to give."
                }
            ]
        }
    ],
    "characters": [
        {
            "id": "BlessedScarab",
            "size": 1,
            "attack_damage": 1,
            "health": 1,
            "names": {
                "english": "Blessed Scarab",
                "chinese": "镀金圣甲虫"
            },
            "character_art": "@BlessedScarabCharacterArt",
            "subtypes": [
                "@Sub_Scarab"
            ],
            "ability": "@ScarabAutoSacrificeAbility",
            "starting_status_effects": [
                {
                    "status": "undying",
                    "count": 2
                }
            ],
            "triggers": [
                "@BlessedScarabTrigger"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "BlessedScarabTrigger",
            "descriptions": {
                "english": "Apply +[effect0.upgrade.bonusdamage][attack] and +[effect0.upgrade.bonushp][health] to friendly units."
            },
            "trigger": "on_death",
            "effects": [
                "@BlessedScarabGiveStats"
            ]
        }
    ],
    "effects": [
        {
            "id": "SpawnBlessedScarab",
            "name": "CardEffectSpawnMonster",
            "target_mode": "room",
            "param_character": "@BlessedScarab"
        },
        {
            "id": "BlessedScarabGiveStats",
            "name": "CardEffectAddTempCardUpgradeToUnits",
            "target_mode": "room",
            "target_team": "monsters",
            "param_upgrade": "@ScarabZeroAttackFourHealth"
        }
    ],
    "sprites": [
        {
            "id": "BlessedScarab",
            "path": "textures/BlessedScarabCardArt.png"
        },
        {
            "id": "BlessedScarabCharacterArt",
            "path": "textures/BlessedScarabCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "BlessedScarab",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@BlessedScarab"
                }
            }
        },
        {
            "id": "BlessedScarabCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@BlessedScarabCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 0,
                            "z": 0.2
                        },
                        "scale": {
                            "x": 1.024,
                            "y": 1.024,
                            "z": 1
                        }
                    }
                }
            }
        }
    ]
}
