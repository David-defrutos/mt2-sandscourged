{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "cards": [
        {
            "id": "SpawnGoldenScarab",
            "names": {
                "english": "Golden Scarab",
                "chinese": "镀金圣甲虫"
            },
            "card_art": "@GoldenScarab",
            "cost": 0,
            "card_type": "monster",
            "rarity": "common",
            "class": "@ClassSandscourged",
            "targets_room": true,
            "pools": [
                "MegaPool"
            ],
            "effects": [
                "@SpawnGoldenScarab"
            ],
            "lore_tooltips": [
                {
                    "english": "The Ur-Pharaoh revels in greed and opulence. Some of his spawn are adorned in precious metals and gems, taken from what little the Scourged have to give."
                }
            ]
        }
    ],
    "characters": [
        {
            "id": "GoldenScarab",
            "size": 1,
            "attack_damage": 0,
            "health": 1,
            "names": {
                "english": "Golden Scarab",
                "chinese": "镀金圣甲虫"
            },
            "character_art": "@GoldenScarabCharacterArt",
            "subtypes": [
                "@Sub_Scarab"
            ],
            "ability": "@ScarabAutoSacrificeAbility",
            "starting_status_effects": [
                {
                    "status": "avarice",
                    "count": 10
                }
            ],
            "triggers": [
                "@GoldenScarabTrigger"
            ]
        }
    ],
    "character_triggers": [
        {
            "id": "GoldenScarabTrigger",
            "descriptions": {
                "english": "Apply +[effect0.upgrade.bonusdamage][attack] and +[effect0.upgrade.bonushp][health] to friendly units. Gain 10 [coin]"
            },
            "trigger": "on_death",
            "effects": [
                "@GoldenScarabGiveStats",
                "@GoldenScarabGold"
            ]
        }
    ],
    "effects": [
        {
            "id": "GoldenScarabGold",
            "name": "CardEffectRewardGold",
            "param_int": 10
        },
        {
            "id": "SpawnGoldenScarab",
            "name": "CardEffectSpawnMonster",
            "target_mode": "room",
            "param_character": "@GoldenScarab"
        },
        {
            "id": "GoldenScarabGiveStats",
            "name": "CardEffectAddTempCardUpgradeToUnits",
            "target_mode": "room",
            "target_team": "monsters",
            "param_upgrade": "@ScarabZeroAttackOneHealth"
        }
    ],
    "sprites": [
        {
            "id": "GoldenScarab",
            "path": "textures/GoldenScarabCardArt.png"
        },
        {
            "id": "GoldenScarabCharacterArt",
            "path": "textures/GoldenScarabCharacterArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "GoldenScarab",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@GoldenScarab"
                }
            }
        },
        {
            "id": "GoldenScarabCharacterArt",
            "type": "character_art",
            "extensions": {
                "character_art": {
                    "sprite": "@GoldenScarabCharacterArt",
                    "transform": {
                        "position": {
                            "x": 0,
                            "y": 0.3,
                            "z": 0
                        },
                        "scale": {
                            "x": 0.512,
                            "y": 0.512,
                            "z": 1
                        }
                    }
                }
            }
        }
    ]
}
